# Salin file ini menjadi ".env" lalu sesuaikan nilainya.
# JANGAN pernah meng-upload file .env ke repository publik.

APP_NAME=CodeMif
APP_ENV=development        # development | production
APP_DEBUG=true             # ubah ke false di production
APP_URL=http://localhost/codenexa/public
APP_TIMEZONE=Asia/Jakarta

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=codenexa_db
DB_USER=root
# Di XAMPP bawaan password root kosong, tetapi sesuaikan dengan instalasi Anda.
DB_PASS=
DB_CHARSET=utf8mb4
DB_TIMEZONE=+07:00

# Tutor AI lokal tanpa biaya API. Instal Ollama, lalu jalankan:
# ollama pull qwen2.5-coder:1.5b
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# Opsional: gunakan OpenAI API berbayar dengan mengganti AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
